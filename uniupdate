#!/bin/bash

# ==============================================================================
# A comprehensive system update script.
# ==============================================================================

RED="\e[31m"
GREEN="\e[32m"
END="\e[0m"

echo -e "${RED}Setting proxy to 127.0.0.1:1080${END}"
PROXY="socks5://127.0.0.1:1080"
export all_proxy="$PROXY"
export http_proxy="$PROXY"
export https_proxy="$PROXY"

# --- Function to hide desktop entries for non-bwrap applications ---
remove_non_bwrap_entries() {
  local list_file="$HOME/.local/share/bubblejail/desktop.txt"
  local apps_dir="/usr/share/applications"
  local commands_to_run=""

  if [ ! -f "$list_file" ]; then
    echo "Error: Non-bwrap list not found at '$list_file'."
    return 1
  fi

  while IFS= read -r app_name; do
    # Skip empty lines or lines with only whitespace
    if [[ -z "${app_name// /}" ]]; then
      continue
    fi

    local desktop_entry="$apps_dir/$app_name.desktop"

    if [ -f "$desktop_entry" ]; then
      echo "  -> Queuing '$app_name.desktop' for hiding."
      commands_to_run+="mv -f '$desktop_entry' '$desktop_entry.bak';"
    fi
  done <"$list_file"

  # Execute all queued commands at once with a single sudo prompt
  if [ -n "$commands_to_run" ]; then
    echo "Applying changes with sudo..."
    if sudo sh -c "$commands_to_run"; then
      echo "Successfully hid desktop entries."
    else
      echo "${RED}An error occurred while hiding desktop entries.${END}"
      return 1
    fi
  else
    echo "No new non-bwrap desktop entries to hide."
  fi
}

# --- Function to prompt the user before running a command block ---
run_or_skip() {
  local description="$1"
  shift
  local command_to_run=("$@")

  echo -e "\n${GREEN}### ${description} ###${END}"
  read -p "Press [Enter] to run, or [s] to skip: " choice

  if [[ "$choice" == "s" || "$choice" == "S" ]]; then
    echo "Skipping."
  else
    echo "-> Running: ${command_to_run[*]}"
    "${command_to_run[@]}"
  fi
}

# --- Function to run AIDE, filter output, and ask to commit ---
update_aide_db() {
  local db_old="/var/lib/aide/aide.db.gz"
  local db_new="/var/lib/aide/aide.db.new.gz"
  local raw_log="/tmp/aide_raw.log"
  local filtered_log="/tmp/aide_filtered.log"

  echo "Initializing AIDE audit..."

  # 1. Run AIDE Update (Generates .new.gz)
  echo "Scanning file system... (this may take a minute)"
  if sudo ionice -c3 nice -n 19 aide --update --config /etc/aide.conf >"$raw_log" 2>&1; then
    aide_exit_code=$?
  else
    aide_exit_code=$?
  fi

  # AIDE returns non-zero if changes are found (which is expected during update)

  # 2. Filter the log
  echo "Filtering report based on recent pacman updates..."
  # We pass the mtime of the OLD db to the filter script if needed,
  # the filter script defaults to checking the DB file itself.
  if [ -f "/usr/local/bin/aide-filter" ]; then
    cat "$raw_log" | /usr/local/bin/aide-filter >"$filtered_log"
  else
    echo "Warning: aide-filter not found, showing raw log."
    cp "$raw_log" "$filtered_log"
  fi

  # 3. Show the User the Filtered Report
  echo -e "${GREEN}### AIDE INTEGRITY REPORT (Filtered) ###${END}"

  # Check if filtered log is empty
  if [ ! -s "$filtered_log" ]; then
    echo "No unexpected changes found (Filter matched everything)."
  else
    bat --style=plain --paging=always "$filtered_log"
  fi

  # 4. Stop updating AIDE DB when there are abnormal changes
  echo -e "\n${RED}Review the changes above.${END}"
  echo "If you see files you did not modify/update, answer N."
  read -p "Overwrite old database with new scan? [y/N]: " confirm

  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    if [ -f "$db_new" ]; then
      echo "Updating database..."
      sudo mv -f "$db_new" "$db_old"
      # Copy the log to persistent storage for record keeping
      sudo cp "$filtered_log" "/var/log/aide/aide-$(date +%F).log"
      echo "Database updated successfully."
    else
      echo "${RED}Error: New database not found!${END}"
    fi
  else
    echo "${RED}Database update ABORTED. keeping old snapshot.${END}"
    if [ -f "$db_new" ]; then
      sudo rm "$db_new"
      echo "Discarded new database scan."
    fi
  fi

  # Cleanup
  rm -f "$raw_log" "$filtered_log"
}

run_or_skip "Updating official repository packages" paru -Syyu --repo
run_or_skip "Updating AUR packages" paru -Sua
run_or_skip "Hiding non-bwrap desktop entries" remove_non_bwrap_entries
run_or_skip "Updating uv tools" uv tool upgrade --all
unset http_proxy
unset https_proxy
run_or_skip "Updating bun packages" bun update -g
run_or_skip "Updating cargo packages" cargo install-update -a
run_or_skip "Audit System Integrity & Update AIDE DB" update_aide_db
run_or_skip "Updating Neovim plugins and tools" nvim --headless "+Lazy! sync" +qa
run_or_skip "Updating Neovim Mason plugins" nvim --headless +Mason +MasonUpdate +qa

unset all_proxy

echo -e "\n${GREEN}### All update tasks complete! ###${END}"
